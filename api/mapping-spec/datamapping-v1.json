{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sengi.sh/datamapper",
  "title": "DataMapper",
  "type": "object",
  "required": [
    "kind",
    "version",
    "metadata",
    "dataset",
    "identity",
    "constants",
    "output",
    "fieldMappings"
  ],
  "properties": {
    "constants": {
      "description": "Values written on every article",
      "type": "object",
      "required": [
        "Language"
      ],
      "properties": {
        "Language": {
          "description": "ISO 639-3 corpus language written on every article",
          "type": "string",
          "enum": [
            "eng"
          ]
        }
      },
      "additionalProperties": false
    },
    "dataset": {
      "description": "Dataset source identifier",
      "type": "string",
      "pattern": "^[a-z0-9-_]+$",
      "minLength": 1,
      "maxLength": 50
    },
    "dateFormat": {
      "description": "Go time format for parsing date/datetime fields",
      "type": "string",
      "default": "2006-01-02T15:04:05Z"
    },
    "fieldMappings": {
      "description": "Array of field mapping definitions",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "required": {
            "description": "Whether a record missing this value is dropped; Title and URL must set it",
            "type": "boolean",
            "default": false
          },
          "separator": {
            "description": "Splits the value of a list target (Metadata.Authors, Metadata.Keywords)",
            "type": "string"
          },
          "source": {
            "description": "Source field name in the dataset",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sourceType": {
            "description": "Source field data type; url normalises the value, and an invalid url counts as missing",
            "type": "string",
            "enum": [
              "string",
              "int",
              "float",
              "bool",
              "date",
              "datetime",
              "url"
            ],
            "default": "string"
          },
          "target": {
            "description": "Article field, or Metadata.Extra.\u003ckey\u003e for a dataset-specific value",
            "type": "string",
            "pattern": "^(URL|Title|Description|Content|PublishedAt|Metadata\\.(ExternalID|PublisherName|Authors|Section|Keywords|Image|DateModified)|Metadata\\.Extra\\.[A-Za-z][A-Za-z0-9_]*)$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "identity": {
      "description": "Which records are one article, and how each article gets its id",
      "type": "object",
      "required": [
        "idKind"
      ],
      "properties": {
        "idKind": {
          "description": "urlHash hashes the url, the same id on every run; random mints a new id per article on every run",
          "type": "string",
          "enum": [
            "urlHash",
            "random"
          ]
        },
        "unique": {
          "description": "Field sets no two articles share; a record that repeats one is dropped and the first kept",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "fields"
            ],
            "properties": {
              "fields": {
                "description": "Article fields whose values together no two articles share; a record with any of them empty never matches",
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "name": {
                "description": "Name the preprocess report counts this rule's drops under",
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "kind": {
      "description": "Resource type identifier",
      "type": "string",
      "enum": [
        "DataMapper"
      ]
    },
    "metadata": {
      "description": "Mapping metadata",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "description": {
          "description": "Description of the mapping configuration",
          "type": "string",
          "maxLength": 500
        },
        "name": {
          "description": "Human-readable name for the mapping configuration",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "additionalProperties": false
    },
    "output": {
      "description": "Canonical package output",
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "description": "Canonical articles file format",
          "type": "string",
          "enum": [
            "parquet",
            "jsonl"
          ]
        }
      },
      "additionalProperties": false
    },
    "version": {
      "description": "API version",
      "type": "string",
      "enum": [
        "v1"
      ]
    }
  },
  "additionalProperties": false
}