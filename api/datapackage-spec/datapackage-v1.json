{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sengi.sh/datapackage-v1",
  "title": "Data package descriptor",
  "type": "object",
  "required": [
    "$schema",
    "name",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "articleSchema": {
      "type": "string"
    },
    "canonical": {
      "type": "object",
      "required": [
        "name",
        "version",
        "resourceHash"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "resourceHash": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "derivedFrom": {
      "type": "object",
      "required": [
        "name",
        "tag",
        "resourceHash"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "resourceHash": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "embedding": {
      "type": "object",
      "required": [
        "model",
        "hfModel",
        "revision",
        "tag",
        "dim",
        "recipe",
        "pooling",
        "normalized",
        "maxTokens",
        "batchSize",
        "dtype"
      ],
      "properties": {
        "batchSize": {
          "type": "integer"
        },
        "dim": {
          "type": "integer"
        },
        "dtype": {
          "type": "string"
        },
        "hfModel": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "maxTokens": {
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "normalized": {
          "type": "boolean"
        },
        "pooling": {
          "type": "string"
        },
        "recipe": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "language": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "preprocess": {
      "type": "object",
      "required": [
        "id",
        "lock",
        "counts"
      ],
      "properties": {
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "count",
              "share",
              "result"
            ],
            "properties": {
              "count": {
                "type": "integer"
              },
              "error": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^(100(\\.0+)?|[0-9]{1,2}(\\.[0-9]+)?)%$"
                  }
                ]
              },
              "result": {
                "type": "string",
                "enum": [
                  "pass",
                  "warn",
                  "error"
                ]
              },
              "share": {
                "type": "number"
              },
              "warn": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^(100(\\.0+)?|[0-9]{1,2}(\\.[0-9]+)?)%$"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "counts": {
          "type": "object",
          "required": [
            "read",
            "written"
          ],
          "properties": {
            "cleared": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "dropped": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "duplicates": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "read": {
              "type": "integer"
            },
            "written": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "id": {
          "type": "object",
          "required": [
            "kind",
            "algorithm"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "uuidv5",
                "uuidv7"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "urlHash",
                "random"
              ]
            },
            "namespace": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "lock": {
          "type": "object",
          "required": [
            "spec",
            "mapping",
            "input",
            "tool"
          ],
          "properties": {
            "input": {
              "type": "string"
            },
            "mapping": {
              "type": "string"
            },
            "spec": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "countDistinct",
              "groupBy",
              "articles",
              "median",
              "p90",
              "p99",
              "max"
            ],
            "properties": {
              "articles": {
                "type": "integer"
              },
              "atLeast": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "countDistinct": {
                "type": "string"
              },
              "groupBy": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "max": {
                "type": "integer"
              },
              "median": {
                "type": "integer"
              },
              "p90": {
                "type": "integer"
              },
              "p99": {
                "type": "integer"
              },
              "top": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "values",
                    "countDistinct",
                    "articles"
                  ],
                  "properties": {
                    "articles": {
                      "type": "integer"
                    },
                    "countDistinct": {
                      "type": "integer"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "producedBy": {
      "type": "object",
      "required": [
        "tool"
      ],
      "properties": {
        "tool": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "raw": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "format",
          "bytes",
          "hash"
        ],
        "properties": {
          "bytes": {
            "type": "integer"
          },
          "format": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "mediatype": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "suite": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
